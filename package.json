{
  "name": "aero-aminos-store",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "owner": "node --env-file-if-exists=.env server/owner.js",
    "backup": "node --env-file-if-exists=.env server/backup.js"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "7.1.7"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.15"
  }
}
