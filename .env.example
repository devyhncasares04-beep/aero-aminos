# Copy to .env for local development. Keep secrets out of source control and chat.
# In hosted production, set these in the hosting provider's private environment.
APP_ORIGIN=http://localhost:4173
PORT=3000
DATABASE_PATH=./data/aero.sqlite
TRUST_PROXY_HOPS=0

# Fail-closed launch switches: do not change until the documented gates pass.
CHECKOUT_ENABLED=false
POLICIES_APPROVED=false
CATALOG_APPROVED=false

# USD is the only implemented currency; confirm with client before setting.
CURRENCY=
# Integer cents; 0 is allowed only when free shipping is approved.
SHIPPING_CENTS=
# included or exclusive; this is a single reviewed rate, not a tax service.
TAX_MODE=
# Basis points: 825 = 8.25%. Explicit 0 requires a reviewed decision.
TAX_RATE_BPS=
TAX_SHIPPING=false
# Comma-separated ISO country codes, no spaces. Only approved destinations.
SHIPPING_COUNTRIES=
OWNER_EMAIL=
SUPPORT_EMAIL=

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Required for live PayPal; confirm this specific catalog with PayPal first.
PAYPAL_CATALOG_APPROVED=false

ZELLE_RECIPIENT=
ZELLE_RECIPIENT_NAME=
ZELLE_BUSINESS_APPROVED=false

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Client-approved plain text, displayed on linked store policy pages.
# All four must be populated AND POLICIES_APPROVED=true before checkout opens.
TERMS_TEXT=
PRIVACY_TEXT=
SHIPPING_POLICY_TEXT=
REFUND_POLICY_TEXT=
